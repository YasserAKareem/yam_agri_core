# Example .env file for Investment Promotion Agency using GTD methodology
# Copy this file to .env and fill in real values.
# NEVER commit a .env file with real credentials.
#
# This configuration is optimized for:
# - Investment promotion agencies
# - GTD (Getting Things Done) methodology
# - Local AI environment for opportunity analysis
# - Build planning and collaboration
# - ERPNext integration for opportunity tracking

# ── Frappe / ERPNext Configuration ──────────────────────────────────────
# Site name - use a meaningful name for your agency
# Examples: invest.agency.gov, ipa.localhost, invest-dev.local
SITE_NAME=invest.localhost
FRAPPE_SITE=invest.localhost

# HTTP port for web access
# Access: http://localhost:8000/desk
HTTP_PUBLISH_PORT=8000

# Database credentials (CHANGE IN PRODUCTION)
DB_ROOT_PASSWORD=ChangeMe_SecurePassword123!
DB_NAME=investment_agency
DB_USER=frappe_invest
DB_PASSWORD=ChangeMe_FrappePassword456!

# Frappe admin password (CHANGE IN PRODUCTION)
# This is the password for the "Administrator" user
ADMIN_PASSWORD=ChangeMe_AdminPassword789!

# Apps to install
# Core apps + investment/opportunity tracking
INSTALL_APPS=erpnext,yam_agri_core

# ── AI Gateway Configuration ────────────────────────────────────────────
# AI Gateway port (separate from main Frappe instance)
AI_GATEWAY_PORT=8001

# Frappe -> AI Gateway connection
AI_GATEWAY_URL=http://ai-gateway:8089/suggest
AI_GATEWAY_TIMEOUT=30

# ── Local AI (Ollama) Configuration ─────────────────────────────────────
# Enable local AI for GTD assistance and opportunity analysis
ENABLE_OLLAMA=1

# Ollama connection URL
# If Ollama runs on host machine (recommended for dev):
OLLAMA_URL=http://host.docker.internal:11434/api/generate
# If Ollama runs in Docker container:
# OLLAMA_URL=http://ollama:11434/api/generate
# If Ollama runs on Linux host:
# OLLAMA_URL=http://172.17.0.1:11434/api/generate

# Default AI model for suggestions
# Lightweight option (recommended for 8GB RAM systems):
OLLAMA_MODEL=llama3.2:3b

# Allowed models (comma-separated)
# Choose models based on your hardware:
# - llama3.2:3b (~2GB RAM) - fast, good for GTD assistance
# - llama3.1:8b (~5GB RAM) - better quality, detailed analysis
# - qwen2.5:7b (~4GB RAM) - structured output, good for planning
# - gemma2:9b (~6GB RAM) - high quality, comprehensive analysis
OLLAMA_ALLOWED_MODELS=llama3.2:3b,llama3.1:8b,qwen2.5:7b

# AI response limits
AI_MAX_TOKENS=800
AI_TEMPERATURE=0.7

# ── GTD Configuration ───────────────────────────────────────────────────
# GTD-specific settings for investment promotion workflow

# Default GTD contexts (used in opportunity categorization)
# Customize based on your team's work contexts
GTD_CONTEXTS=@office,@calls,@computer,@field,@meetings,@travel

# Review frequency (days)
GTD_WEEKLY_REVIEW_DAY=Friday
GTD_MONTHLY_REVIEW_DAY=1

# Auto-categorization thresholds (used by AI)
GTD_HIGH_PRIORITY_THRESHOLD=5000000    # Investment > $5M = High priority
GTD_JOB_CREATION_THRESHOLD=100         # Jobs > 100 = High priority
GTD_QUICK_ACTION_MINUTES=15            # Actions < 15min = Quick

# ── Investment Opportunity Settings ─────────────────────────────────────
# Sector priorities (affects AI scoring)
PRIORITY_SECTORS=Manufacturing,Technology,Agriculture,Tourism,Renewable Energy

# Investment size thresholds (USD)
SMALL_INVESTMENT_MAX=1000000           # < $1M
MEDIUM_INVESTMENT_MAX=10000000         # $1M - $10M
LARGE_INVESTMENT_MIN=10000000          # > $10M

# Risk tolerance (affects AI risk assessment)
RISK_TOLERANCE=Medium                   # Low/Medium/High

# Approval workflow (affects GTD organization)
REQUIRE_DIRECTOR_APPROVAL_THRESHOLD=5000000  # > $5M needs director approval
REQUIRE_BOARD_APPROVAL_THRESHOLD=25000000    # > $25M needs board approval

# ── Collaboration Settings ──────────────────────────────────────────────
# Email integration for capture phase
EMAIL_CAPTURE_ENABLED=1
EMAIL_CAPTURE_ADDRESS=opportunities@agency.gov

# Calendar integration
CALENDAR_INTEGRATION=google            # google/outlook/none
CALENDAR_SYNC_INTERVAL=15              # minutes

# Notification settings
NOTIFY_NEW_OPPORTUNITY=1
NOTIFY_HIGH_RISK=1
NOTIFY_WEEKLY_REVIEW=1

# ── Build Planning Settings ─────────────────────────────────────────────
# Project planning parameters
DEFAULT_PROJECT_PHASES=Feasibility,Design,Approvals,Construction,Operation
DEFAULT_CONTINGENCY_PERCENT=15         # % buffer for timeline estimates
DEFAULT_RISK_REVIEW_FREQUENCY=Monthly

# Resource planning
TEAM_CAPACITY_HOURS_PER_WEEK=160       # Total team capacity
SENIOR_ANALYST_CAPACITY=40             # Hours per week per senior
JUNIOR_ANALYST_CAPACITY=40             # Hours per week per junior

# ── Performance and Resource Limits ────────────────────────────────────
# Memory limits (for 8GB RAM systems)
# Uncomment and adjust if running on low-memory machines
# DOCKER_MEMORY_LIMIT_DB=512m
# DOCKER_MEMORY_LIMIT_FRAPPE=2g
# DOCKER_MEMORY_LIMIT_AI_GATEWAY=512m

# Gunicorn workers and threads
GUNICORN_WORKERS=2
GUNICORN_THREADS=4

# MariaDB connection pool
MARIADB_MAX_CONNECTIONS=50

# Redis memory limits
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# ── Offline/Field Deployment Settings ──────────────────────────────────
# For agencies with intermittent internet or field offices

# Offline image archive path
# Run: bash run.sh prefetch
# This creates a ~3-4GB archive of all Docker images
OFFLINE_IMAGES_ARCHIVE=./offline-images.tar

# Backup schedule (cron format)
BACKUP_SCHEDULE=0 2 * * *              # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# Sync settings (for field offices)
SYNC_ENABLED=0
SYNC_CENTRAL_URL=https://central.agency.gov
SYNC_INTERVAL_HOURS=6

# ── VPN / Remote Access ─────────────────────────────────────────────────
# If accessing via VPN (e.g., WireGuard)
# VPN_HOSTNAME=invest-dev.vpn.internal
# FRAPPE_SITE_NAME_HEADER=${VPN_HOSTNAME}

# ── Security Settings ───────────────────────────────────────────────────
# Site isolation (multi-office agencies)
ENFORCE_SITE_ISOLATION=1

# Session timeout (minutes)
SESSION_TIMEOUT=60

# Password policy
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_SPECIAL_CHARS=1
PASSWORD_REQUIRE_NUMBERS=1

# Two-factor authentication
ENABLE_2FA=1                           # Recommended for production

# ── Logging and Monitoring ──────────────────────────────────────────────
# Log level (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO

# AI interaction logging
LOG_AI_INTERACTIONS=1
LOG_AI_PROMPTS=1                       # For audit/improvement
LOG_AI_RESPONSES=1

# Performance monitoring
ENABLE_METRICS=1
METRICS_PORT=9090

# ── Development vs Production ───────────────────────────────────────────
# Environment mode
ENVIRONMENT=development                # development/staging/production

# Debug mode (NEVER enable in production)
DEBUG_MODE=1

# Auto-reload on code changes (dev only)
AUTO_RELOAD=1

# ── Custom Agency Settings ──────────────────────────────────────────────
# Customize these based on your agency's specific needs

# Agency name and branding
AGENCY_NAME=Investment Promotion Agency
AGENCY_SHORT_NAME=IPA
AGENCY_LOGO_URL=/files/agency-logo.png

# Agency contact info (used in automated emails)
AGENCY_CONTACT_EMAIL=info@agency.gov
AGENCY_CONTACT_PHONE=+1-555-0100
AGENCY_WEBSITE=https://www.agency.gov

# Regions/Zones (for multi-regional agencies)
REGIONS=North,South,East,West,Central

# Industries tracked
INDUSTRIES=Manufacturing,Services,Agriculture,Technology,Tourism,Mining,Energy,Construction

# ── External System Integration ────────────────────────────────────────
# CRM Integration
CRM_INTEGRATION=salesforce             # salesforce/hubspot/none
CRM_API_KEY=                           # Leave empty, set via env variable
CRM_SYNC_ENABLED=0

# ERP Integration (if using separate ERP)
ERP_INTEGRATION=none                   # sap/oracle/none
ERP_API_URL=

# Government Portal Integration
GOV_PORTAL_ENABLED=0
GOV_PORTAL_API_URL=
GOV_PORTAL_API_KEY=

# ── Analytics and Reporting ─────────────────────────────────────────────
# Enable advanced analytics
ENABLE_ANALYTICS=1

# Data retention (days)
DATA_RETENTION_DAYS=1825               # 5 years

# Report generation schedule
GENERATE_WEEKLY_REPORT=1
GENERATE_MONTHLY_REPORT=1
GENERATE_QUARTERLY_REPORT=1

# Export formats
ENABLE_PDF_EXPORT=1
ENABLE_EXCEL_EXPORT=1
ENABLE_CSV_EXPORT=1

# ── Notes ────────────────────────────────────────────────────────────────
# 1. After copying to .env, change all "ChangeMe_" passwords
# 2. Install Ollama: https://ollama.com/download
# 3. Pull AI models: ollama pull llama3.2:3b
# 4. Start stack: cd infra/docker && bash run.sh up
# 5. Initialize: bash run.sh init
# 6. Access: http://localhost:8000
#
# For detailed setup guide, see: docs/DEVOPS_AI_GTD_SETUP.md
#
# For GTD methodology: https://todoist.com/productivity-methods/getting-things-done
#
# Support: https://github.com/YasserAKareem/yam_agri_core/issues
